# Dependencies
node_modules/
**/node_modules/

# Env files (keep examples)
.env
.env.local
.env.*.local
frontend/.env.local
*.env
!.env.example
!frontend/.env.example

# Build outputs
backend-rs/target/
frontend/.next/
coverage/
.turbo/

# Runtime storage and generated data
storage/uploads/*
storage/subtitles/*
storage/output/*
storage/temp/*
storage/data/*.sqlite
storage/data/*.sqlite-*
!storage/uploads/.gitkeep
!storage/subtitles/.gitkeep
!storage/output/.gitkeep
!storage/temp/.gitkeep
!storage/data/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backup / temp files
*.bak
*.tmp
*.temp
*.swp
*.swo
*~

# Archives / exports
*.zip
*.tar
*.tar.gz

# OS/editor
.DS_Store
.vscode/
.idea/
